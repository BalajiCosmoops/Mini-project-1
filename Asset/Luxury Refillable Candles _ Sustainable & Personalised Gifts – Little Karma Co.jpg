                "checkoutBtn": "button[name=\"checkout\"], #CartDrawer-Checkout",
                "discountBox": "[samitaWS-cart-discount-box]"
            }],
            "drawerForm": [
                "[samitaWS-drawer-form]",
                "#CartDrawer"
            ],
            "drawer": [
                {
                  "btnClose": "button.drawer__close",
                  "lineItem": {
                      "key": ".samitaWS-drawer-line-item-key, .cart-item",
                      "quantity": {
